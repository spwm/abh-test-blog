{
    "name": "test/blog",
    "description": "Test assignment: PHP + Smarty + MySQL blog",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-gd": "*",
        "smarty/smarty": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "fakerphp/faker": "^1.23",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "stan": "phpstan analyse",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "rector": "rector process --dry-run",
        "rector-fix": "rector process",
        "analyse": [
            "@stan",
            "@cs"
        ]
    }
}
