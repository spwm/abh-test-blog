<?xml version="1.0"?>
<ruleset name="Blog">
    <description>PSR-12 coding standard for app, bin, database, tests</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="p"/>

    <file>app</file>
    <file>bin</file>
    <file>database</file>
    <file>tests</file>

    <rule ref="PSR12"/>
</ruleset>
